# 复制为 vps-3x-ui.env 并填入真实值；vps-3x-ui.env 已加入 .gitignore，勿提交
# cp scripts/vps-3x-ui.env.example scripts/vps-3x-ui.env
#
# 在 VPS 上也可放在 /root/vps-3x-ui.env，或安装时通过环境变量传入

# 客户端连接用的域名（橙云代理，勿填 VPS IP）
SSL_DOMAIN="jp.example.com"

# Let's Encrypt 注册邮箱
SSL_EMAIL="you@example.com"

# Cloudflare API Token（DNS-01 签证书；橙云节点必填）
# 权限：Zone - DNS - Edit（限定到该 Zone）
CF_TOKEN=""
