# 复制为 secrets.yaml 并填入真实值；secrets.yaml 已加入 .gitignore，勿提交
# cp secrets.yaml.example secrets.yaml

secret: "YOUR_API_SECRET"

proxies:
  - name: HOME-SOCKS5-US
    type: socks5
    server: YOUR_US_SERVER
    port: 12324
    username: YOUR_US_USERNAME
    password: YOUR_US_PASSWORD
    udp: true
    dialer-proxy: US
  - name: HOME-SOCKS5-SSRDOG-US
    type: socks5
    server: YOUR_US_SERVER
    port: 12324
    username: YOUR_US_USERNAME
    password: YOUR_US_PASSWORD
    udp: true
    dialer-proxy: SSRDOG
  - name: HOME-SOCKS5-JP
    type: socks5
    server: YOUR_JP_SERVER
    port: 12324
    username: YOUR_JP_USERNAME
    password: YOUR_JP_PASSWORD
    udp: true
    dialer-proxy: US
  - name: HOME-SOCKS5-SSRDOG-JP
    type: socks5
    server: YOUR_JP_SERVER
    port: 12324
    username: YOUR_JP_USERNAME
    password: YOUR_JP_PASSWORD
    udp: true
    dialer-proxy: SSRDOG
  - name: HOME-SOCKS5-DE
    type: socks5
    server: YOUR_DE_SERVER
    port: 12324
    username: YOUR_DE_USERNAME
    password: YOUR_DE_PASSWORD
    udp: true
    dialer-proxy: US
  - name: HOME-SOCKS5-SSRDOG-DE
    type: socks5
    server: YOUR_DE_SERVER
    port: 12324
    username: YOUR_DE_USERNAME
    password: YOUR_DE_PASSWORD
    udp: true
    dialer-proxy: SSRDOG

proxy-providers:
  ssrdog:
    url: "https://YOUR_TOKEN.YOUR_SUB_DOMAIN/s?t=YOUR_TOKEN.jpg"
  us:
    url: "https://cdn.statry.xyz:2096/sbsub/YOUR_US_SUB_TOKEN"
  jp:
    url: "https://sub.jp.statry.xyz:2096/subbus/YOUR_JP_SUB_TOKEN"

dns:
  nameserver-policy:
    "YOUR_SUB_DOMAIN": [223.5.5.5, 119.29.29.29]
    "statry.xyz": [223.5.5.5, 119.29.29.29]

# 插入 rules 第 2 条起（紧跟 dog.ssrdog.com 直连规则之后）
prepend-rules:
  - "DOMAIN-SUFFIX,YOUR_SUB_DOMAIN,DIRECT"
  - "DOMAIN-SUFFIX,YOUR_US_NODE_DOMAIN,DIRECT"
